# ── AI provider (LLM-agnostic — switching provider is a config change only) ──
# One of: anthropic | openai | gemini
AI_PROVIDER=anthropic
AI_API_KEY=your-key-here
# Optional. Defaults per provider: claude-opus-5 / gpt-4o / gemini-2.5-flash
AI_MODEL=

# ── Shopify (populated automatically by `shopify app dev` — leave empty) ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_products,write_content
